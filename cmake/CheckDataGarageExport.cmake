# Exports the bundled intersection twice per delivery mode and requires identical event files, a
# completed manifest and an event count that matches the file.
file(REMOVE_RECURSE "${OUT}")
foreach(mode in_order network)
    foreach(attempt first second)
        execute_process(COMMAND "${SIM_CLI}" --duration 30 --datagarage "${OUT}/${attempt}" --run-id ${mode} --delivery ${mode}
            RESULT_VARIABLE result OUTPUT_QUIET)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "sim_cli failed for ${mode} (${attempt}): ${result}")
        endif()
    endforeach()
    file(SHA256 "${OUT}/first/${mode}/events.jsonl" first_hash)
    file(SHA256 "${OUT}/second/${mode}/events.jsonl" second_hash)
    if(NOT first_hash STREQUAL second_hash)
        message(FATAL_ERROR "${mode}: two runs of the same configuration wrote different events")
    endif()
    file(READ "${OUT}/first/${mode}/run.json" manifest)
    string(JSON status GET "${manifest}" status)
    string(JSON count GET "${manifest}" event_count)
    file(STRINGS "${OUT}/first/${mode}/events.jsonl" lines)
    list(LENGTH lines line_count)
    if(NOT status STREQUAL "completed" OR NOT count EQUAL line_count OR line_count EQUAL 0)
        message(FATAL_ERROR "${mode}: status ${status}, event_count ${count}, ${line_count} lines")
    endif()
    message(STATUS "${mode}: ${line_count} events, deterministic")
endforeach()
